# ==============================================================================
# .gitignore — Aturan Pengabaian Berkas Git Kelompok 9
# ==============================================================================

# 1. Environment & Credentials (SANGAT RAHASIA - JANGAN DI-COMMIT)
.env
config/db.php
identity.php

# 2. Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# 3. IDE & Code Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 4. Logs & Temporary
*.log
tmp/
