# ==============================================================================
# .env.example — Template Konfigurasi Lingkungan Kelompok 9
# ==============================================================================
# Salin file ini menjadi '.env' di laptop Anda:
#   Windows: copy .env.example .env
# File '.env' dilindungi oleh .gitignore dan TIDAK AKAN PERNAH di-commit ke Git.
# ==============================================================================

# 1. Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kelompok_db
DB_USER=app_local
DB_PASS=password_lokal

# 2. Identitas Node Server / Mahasiswa
# MEMBER_ROUTE diisi: m0 (ketua), m1, m2, atau m3 (anggota)
MEMBER_ROUTE=m0
MEMBER_NAMA=Nama Lengkap Anda
MEMBER_NIM=NIM Anda
